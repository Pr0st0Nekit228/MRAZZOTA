local _payload = function(assetId: number): payloadType
    local itemInfo = env.Market:GetProductInfo(assetId)

    local payload = {
        collectibleItemId = tostring(itemInfo.CollectibleItemId),
        collectibleProductId = tostring(itemInfo.CollectibleProductId),
        expectedCurrency = 1,
        expectedPrice = itemInfo.PriceInRobux,
        idempotencyKey = env.Http:GenerateGUID(false),
        expectedSellerId = itemInfo.Creator.Id,
        expectedSellerType = tostring(itemInfo.Creator.CreatorType),
        expectedPurchaserType = "User",
        expectedPurchaserId = env.Players.LocalPlayer.UserId
    }

    local metadata = {
        AssetId = itemInfo.AssetId,
        Name = itemInfo.Name,
        Description = itemInfo.Description,
        AssetTypeId = itemInfo.AssetTypeId,
        ProductType = itemInfo.ProductType,
        IsForSale = itemInfo.IsForSale,
        IsLimited = itemInfo.IsLimited,
        IsLimitedUnique = itemInfo.IsLimitedUnique,
        Remaining = itemInfo.Remaining,
        Sales = itemInfo.Sales,
        Created = itemInfo.Created,
        Updated = itemInfo.Updated,
        MinimumMembershipLevel = itemInfo.MinimumMembershipLevel,
        ContentRatingTypeId = itemInfo.ContentRatingTypeId,
        IconImageAssetId = itemInfo.IconImageAssetId,
        TargetId = itemInfo.TargetId,
        CollectibleItemId = itemInfo.CollectibleItemId,
        CollectibleProductId = itemInfo.CollectibleProductId,
        Creator = {
            Id = itemInfo.Creator.Id,
            Name = itemInfo.Creator.Name,
            CreatorType = itemInfo.Creator.CreatorType,
            CreatorTargetId = itemInfo.Creator.CreatorTargetId,
            HasVerifiedBadge = itemInfo.Creator.HasVerifiedBadge
        }
    }

    return {
        payload = payload,
        metadata = metadata
    }
end

local _unprotect_call = function(identity: number, callback: () -> ()): nil
    local suc, err = pcall(function()
        local mt = debug.getmetatable(game)
        make_writeable(mt)

        local payload_ran = false
        local old = mt.__namecall
        mt.__namecall = C(function(...)
            if payload_ran == false then
                payload_ran = true
                pcall(function()
                    env._ThreadIdentity(identity)
                    callback()
                end)
            end

            return old(...)
        end)
    end)

    if not suc then
        print("Setup error: " .. tostring(err))
        notify("Setup error: " .. tostring(err), {
            icon = icons["lucide-x-circle"],
            textColor = Color3.fromRGB(255, 255, 255),
            accentColor = Color3.fromRGB(239, 68, 68)
        })
    end
end


local _BUY = function(assetId: number): string
    local apiResponse = nil
    local isFinished = false
    local decoded = nil
    local startTime = nil

    _unprotect_call(7, function()
        local itemPayload = _payload(assetId).payload
        startTime = os.clock()
        
        local response = env.HttpRbxApi:PostAsyncFullUrl(
            "https://apis.roblox.com/marketplace-sales/v1/item/" .. tostring(itemPayload.collectibleItemId) .. "/purchase-item",
            env.Http:JSONEncode(itemPayload)
        )
        apiResponse = response
        decoded = env.Http:JSONDecode(apiResponse)
        isFinished = true
    end)

    while not isFinished do
        task.wait()
    end

    if decoded and decoded.purchased then
        print("It took " .. os.clock() - startTime .. " to purchase the item")
    end

    return apiResponse
end

env.ConnectSocket = C(function(url: string): RBXScriptConnection
    if(not config.Paid.enable and not config.Website.enable) then return end
    local success, response = env.xpcall(function()
        return env.WebSocket.connect(url)
    end, function(err)
        env.print("[Socket Error]", err)
        return nil
    end)

    if not success or not response then
        env.print("Something went wrong, can't connect")
        notify("Something went wrong, can't connect", {
            icon = icons["lucide-wifi-off"],
            textColor = Color3.fromRGB(255, 255, 255),
            accentColor = Color3.fromRGB(239, 68, 68)
        })
        return nil
    end

    local initResponse = request({
        Url = "https://neriumsearch.onrender.com/api/collectibles/all",
        Method = "GET"
    })

    local previous = env.Http:JSONDecode(initResponse.Body).collectibles
    local socket = response

    socket.OnMessage:Connect(C(function(message)
        local collectibles = env.Http:JSONDecode(message).collectibles

        if previous == nil then
            previous = collectibles
            return
        end

        if collectibles.paid ~= nil and collectibles.paid ~= previous.paid then
            local itemData = _payload(collectibles.paid)
            local creatorId = itemData.metadata.Creator.CreatorTargetId
            local creatorName = itemData.metadata.Creator.Name
            local assetType = itemData.metadata.AssetTypeId
            local itemPrice = itemData.payload.expectedPrice
            local itemName = itemData.metadata.Name

            notify("Detected — " .. itemName .. " by " .. creatorName .. "......", {
                icon = icons["lucide-package-search"],
                textColor = Color3.fromRGB(255, 255, 255),
                accentColor = Color3.fromRGB(21, 0, 253)
            })

            if config.Paid["creator settings"].blocklist.enable then
                if table.find(config.Paid["creator settings"].blocklist.creatorsId, creatorId) then
                    env.print("Skipping the creator blacklisted")
                    notify("Skipping — " .. itemName .. " by " .. creatorName .. " is blacklisted", {
                        icon = icons["lucide-shield-off"],
                        textColor = Color3.fromRGB(255, 255, 255),
                        accentColor = Color3.fromRGB(239, 68, 68)
                    })
                    return
                end
            end

            if not (itemPrice >= config.Paid["price target"]["minimum"] and itemPrice <= config.Paid["price target"]["maximum"]) then
                env.print("item was not on range of price")
                notify("Item price is outside your configured range.", {
                    icon = icons["lucide-filter-x"],
                    textColor = Color3.fromRGB(255, 170, 0),
                    accentColor = Color3.fromRGB(255, 115, 0)
                })
                return
            end

            if config.Paid["specific type"].enable then
                if not table.find(config.Paid["specific type"].assetType, assetType) then
                    print("asset does not match skipping")
                    return
                end
            end

            if config.Paid["creator settings"].whitelist.enable then
                if table.find(config.Paid["creator settings"].whitelist.creatorsId, creatorId) then
                    print("buying via whitelist")
                    notify("Buying whitelisted item — " .. itemName .. " by " .. creatorName .. " for " .. itemPrice .. " R$", {
                        icon = icons["lucide-shopping-cart"],
                        textColor = Color3.fromRGB(255, 255, 255),
                        accentColor = Color3.fromRGB(59, 130, 246)
                    })
                    task.spawn(function()
                        local buyResultRaw = _BUY(collectibles.paid)
                        local decodeSuccess, decodedResult = pcall(function()
                            return env.Http:JSONDecode(buyResultRaw)
                        end)
                        if decodeSuccess and decodedResult.purchased == true then
                            print("successfully bought whitelisted item")
                            notify("Successfully bought — " .. itemName .. " by " .. creatorName .. " for " .. itemPrice .. " R$", {
                                icon = icons["lucide-check-circle"],
                                textColor = Color3.fromRGB(5, 101, 21),
                                accentColor = Color3.fromRGB(13, 255, 5)
                            })
                        end
                    end)
                    return
                end
            end

            if config.Paid.enable then
                print("Buying freely")
                notify("Attempting to buy — " .. itemName .. " by " .. creatorName .. " for " .. itemPrice .. " R$", {
                    icon = icons["lucide-shopping-cart"],
                    textColor = Color3.fromRGB(255, 255, 255),
                    accentColor = Color3.fromRGB(59, 130, 246)
                })
                task.spawn(function()
                    local buyResultRaw = _BUY(collectibles.paid)
                    local decodeSuccess, decodedResult = pcall(function()
                        return env.Http:JSONDecode(buyResultRaw)
                    end)
                    if decodeSuccess and decodedResult.purchased == true then
                        notify("Successfully bought — " .. itemName .. " by " .. creatorName .. " for " .. itemPrice .. " R$", {
                            icon = icons["lucide-check-circle"],
                            textColor = Color3.fromRGB(5, 101, 21),
                            accentColor = Color3.fromRGB(13, 255, 5)
                        })
                    end
                end)
            else
                print("Skipping: General buying is off and creator was not whitelisted")
                notify("Skipping — " .. itemName .. " by " .. creatorName .. " | Buying is disabled and creator is not whitelisted", {
                    icon = icons["lucide-lock"],
                    textColor = Color3.fromRGB(255, 255, 255),
                    accentColor = Color3.fromRGB(239, 68, 68)
                })
            end
        end

        if collectibles.website ~= nil and collectibles.website ~= previous.website then
            local itemData = _payload(collectibles.website)
            local itemName = itemData.metadata.Name
            local creatorName = itemData.metadata.Creator.Name

            notify("Detected — " .. itemName .. " by " .. creatorName .. "......", {
                icon = icons["lucide-package-search"],
                textColor = Color3.fromRGB(255, 255, 255),
                accentColor = Color3.fromRGB(21, 0, 253)
            })

            if config.Website.enable and itemData.payload.expectedPrice == 0 and itemData.metadata.IsForSale then
                print("Buying free website item")
                notify("Attempting to buy — " .. itemName .. " by " .. creatorName .. " (Free)", {
                    icon = icons["lucide-shopping-cart"],
                    textColor = Color3.fromRGB(255, 255, 255),
                    accentColor = Color3.fromRGB(59, 130, 246)
                })
                task.spawn(function()
                    local buyResultRaw = _BUY(collectibles.website)
                    local decodeSuccess, decodedResult = pcall(function()
                        return env.Http:JSONDecode(buyResultRaw)
                    end)
                     print(decodeSuccess)
                    if decodeSuccess and decodedResult.purchased == true then
                       
                        env.print("successfully bought free website item")
                        notify("Successfully bought — " .. itemName .. " by " .. creatorName .. " (Free)", {
                            icon = icons["lucide-check-circle"],
                            textColor = Color3.fromRGB(255, 255, 255),
                            accentColor = Color3.fromRGB(34, 197, 94)
                        })
                    end
                end)
            else
                if not itemData.metadata.IsForSale then
                    env.print("item not for sale")
                    notify("Not for sale — " .. itemName .. " by " .. creatorName, {
                        icon = icons["lucide-store"],
                        textColor = Color3.fromRGB(255, 255, 255),
                        accentColor = Color3.fromRGB(239, 68, 68)
                    })
                end
            end
        end

        previous = collectibles
    end))

    notify("Connected!", {
        icon = icons["lucide-globe"],
        accentColor = Color3.fromRGB(64, 255, 0)
    })

    return socket
end)


